<Page
    x:Class="Measures.MeasuresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:Measures.Charts"
    xmlns:controls="using:Measures.Controls"
    Background="{StaticResource PageBrush}">

    <Grid x:Name="Root" IsTabStop="True" UseSystemFocusVisuals="False">

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
            <!-- single column below 620: the cards read as a list -->
            <VisualState x:Name="Narrow" />

            <VisualState x:Name="Wide">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="620" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="Pad.Padding" Value="56" />

                    <Setter Target="RidgeCard.(Grid.Row)" Value="0" />
                    <Setter Target="RidgeCard.(Grid.Column)" Value="0" />
                    <Setter Target="RidgeCard.(Grid.ColumnSpan)" Value="1" />

                    <Setter Target="SessionsCard.(Grid.Row)" Value="0" />
                    <Setter Target="SessionsCard.(Grid.Column)" Value="1" />
                    <Setter Target="SessionsCard.(Grid.ColumnSpan)" Value="1" />

                    <Setter Target="NightCard.(Grid.Row)" Value="1" />
                    <Setter Target="NightCard.(Grid.Column)" Value="0" />
                    <Setter Target="NightCard.(Grid.ColumnSpan)" Value="1" />

                    <Setter Target="RoadCard.(Grid.Row)" Value="1" />
                    <Setter Target="RoadCard.(Grid.Column)" Value="1" />
                    <Setter Target="RoadCard.(Grid.ColumnSpan)" Value="1" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- a whisper of grain over the whole field, under everything on it -->
    <controls:GrainLayer Opacity="0.18" />

    <ScrollViewer
        x:Name="Scroll"
        HorizontalScrollMode="Disabled"
        IsTabStop="False"
        VerticalScrollBarVisibility="Auto">

        <Grid x:Name="Pad" Padding="20">
            <Grid
                x:Name="Wrap"
                MaxWidth="856"
                HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ══ header ══ -->
                <Grid Margin="0,0,0,28" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Bottom"
                        FontFamily="{StaticResource SerifItalicFont}"
                        FontSize="{StaticResource TitleSize}"
                        FontStyle="Italic"
                        Foreground="{StaticResource InkBrush}"
                        Text="measures" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="16">
                        <controls:SpacedText
                            VerticalAlignment="Bottom"
                            Style="{StaticResource LabelStyle}"
                            Text="Without thought" />
                        <!-- the scheme, in the reader's hand rather than only the system's -->
                        <Button
                            x:Name="ThemeButton"
                            AutomationProperties.Name="Switch between light and dark"
                            Click="OnToggleTheme"
                            Style="{StaticResource QuietButtonStyle}">
                            <controls:SpacedText x:Name="ThemeLabel" Style="{StaticResource LabelStyle}" Text="Dark" />
                        </Button>
                        <!-- replays every entrance, for showing the page cold -->
                        <Button
                            x:Name="ReplayButton"
                            AutomationProperties.Name="Replay the entrance"
                            Click="OnReplay"
                            Style="{StaticResource QuietButtonStyle}">
                            <controls:SpacedText Style="{StaticResource LabelStyle}" Text="Replay" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ══ the bench ══ -->
                <Grid
                    x:Name="Bench"
                    Grid.Row="1"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- the period labels of the ridge and the sessions are live range switchers -->
                    <controls:MeasureCard
                        x:Name="RidgeCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        FootRight="hours"
                        HeadLeft="Deep work"
                        IsRangeSwitch="True"
                        RiseDelay="0"
                        Temperature="Effort">
                        <charts:RidgeChart x:Name="Ridge" />
                    </controls:MeasureCard>

                    <controls:MeasureCard
                        x:Name="SessionsCard"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        FootRight="focus"
                        HeadLeft="Sessions"
                        IsRangeSwitch="True"
                        RiseDelay="120"
                        Temperature="Frequency">
                        <charts:StepChart x:Name="Sessions" />
                    </controls:MeasureCard>

                    <controls:MeasureCard
                        x:Name="NightCard"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        AxisLabels="21, 00, 03, 06, 09"
                        FootRight="restful"
                        HeadLeft="Sleep"
                        HeadRight="Last night"
                        RiseDelay="240"
                        Temperature="Rest">
                        <charts:NightChart x:Name="Night" />
                    </controls:MeasureCard>

                    <controls:MeasureCard
                        x:Name="RoadCard"
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        AxisLabels="0, 25 km"
                        HeadLeft="Running"
                        HeadRight="This week"
                        RiseDelay="360"
                        Temperature="Distance">
                        <charts:RoadChart x:Name="Road" />
                    </controls:MeasureCard>

                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
