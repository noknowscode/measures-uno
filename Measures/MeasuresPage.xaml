<Page
    x:Class="Measures.MeasuresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:Measures.Charts"
    xmlns:controls="using:Measures.Controls"
    Background="{StaticResource PageBrush}">

    <Grid x:Name="Root" IsTabStop="True" UseSystemFocusVisuals="False">

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
            <!--
              One card at a time on every width. Three rooms for it:
              narrow keeps a compact head and pips; medium earns the tagline and
              more field; wide swaps the pips for an index rail at the left that
              names the four instruments and turns the carousel.
            -->
            <VisualState x:Name="Narrow" />

            <VisualState x:Name="Medium">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="620" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="Pad.Padding" Value="56" />
                    <Setter Target="Tagline.Visibility" Value="Visible" />

                    <Setter Target="RidgeTile.(Grid.Row)" Value="0" />
                    <Setter Target="RidgeTile.(Grid.Column)" Value="0" />
                    <Setter Target="RidgeTile.(Grid.ColumnSpan)" Value="1" />
                    <Setter Target="SessionsTile.(Grid.Row)" Value="0" />
                    <Setter Target="SessionsTile.(Grid.Column)" Value="1" />
                    <Setter Target="SessionsTile.(Grid.ColumnSpan)" Value="1" />
                    <Setter Target="NightTile.(Grid.Row)" Value="1" />
                    <Setter Target="NightTile.(Grid.Column)" Value="0" />
                    <Setter Target="NightTile.(Grid.ColumnSpan)" Value="1" />
                    <Setter Target="RoadTile.(Grid.Row)" Value="1" />
                    <Setter Target="RoadTile.(Grid.Column)" Value="1" />
                    <Setter Target="RoadTile.(Grid.ColumnSpan)" Value="1" />
                </VisualState.Setters>
            </VisualState>

            <VisualState x:Name="Wide">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="1100" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="Pad.Padding" Value="56" />
                    <Setter Target="Tagline.Visibility" Value="Visible" />
                    <Setter Target="Pips.Visibility" Value="Collapsed" />
                    <Setter Target="Index.Visibility" Value="Visible" />
                    <Setter Target="IndexColumn.Width" Value="220" />
                    <Setter Target="Carousel.(Grid.Column)" Value="1" />

                    <Setter Target="RidgeTile.(Grid.Row)" Value="0" />
                    <Setter Target="RidgeTile.(Grid.Column)" Value="0" />
                    <Setter Target="RidgeTile.(Grid.ColumnSpan)" Value="1" />
                    <Setter Target="SessionsTile.(Grid.Row)" Value="0" />
                    <Setter Target="SessionsTile.(Grid.Column)" Value="1" />
                    <Setter Target="SessionsTile.(Grid.ColumnSpan)" Value="1" />
                    <Setter Target="NightTile.(Grid.Row)" Value="1" />
                    <Setter Target="NightTile.(Grid.Column)" Value="0" />
                    <Setter Target="NightTile.(Grid.ColumnSpan)" Value="1" />
                    <Setter Target="RoadTile.(Grid.Row)" Value="1" />
                    <Setter Target="RoadTile.(Grid.Column)" Value="1" />
                    <Setter Target="RoadTile.(Grid.ColumnSpan)" Value="1" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- a whisper of grain over the whole field, under everything on it -->
    <controls:GrainLayer Grain="0.18" />

    <ScrollViewer
        x:Name="Scroll"
        HorizontalScrollMode="Disabled"
        IsTabStop="False"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled">

        <Grid x:Name="Pad" Padding="20">
            <Grid
                x:Name="Wrap"
                MaxWidth="1040"
                HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- the index rail; zero until the wide room opens it -->
                    <ColumnDefinition x:Name="IndexColumn" Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ══ header ══ -->
                <Grid Grid.ColumnSpan="2" Margin="0,0,0,28" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Bottom"
                        FontFamily="{StaticResource SerifItalicFont}"
                        FontSize="{StaticResource TitleSize}"
                        FontStyle="Italic"
                        Foreground="{StaticResource InkBrush}"
                        Text="measures" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="16">
                        <controls:SpacedText
                            x:Name="Tagline"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource LabelStyle}"
                            Text="Without thought"
                            Visibility="Collapsed" />
                        <!-- the scheme, in the reader's hand rather than only the system's -->
                        <Button
                            x:Name="ThemeButton"
                            AutomationProperties.Name="Switch between light and dark"
                            Click="OnToggleTheme"
                            Style="{StaticResource QuietButtonStyle}">
                            <controls:SpacedText x:Name="ThemeLabel" Style="{StaticResource LabelStyle}" Text="Dark" />
                        </Button>
                        <!-- replays every entrance, for showing the page cold -->
                        <Button
                            x:Name="ReplayButton"
                            AutomationProperties.Name="Replay the entrance"
                            Click="OnReplay"
                            Style="{StaticResource QuietButtonStyle}">
                            <controls:SpacedText Style="{StaticResource LabelStyle}" Text="Replay" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--
                  ══ the pips ══
                  Which room the reader is in. Contrast, not hue -
                  the current one is charcoal, the rest are 35% ink.
                -->
                <StackPanel
                    x:Name="Pips"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,-22,0,10"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="0" />

                <!--
                  ══ the carousel ══
                  One instrument at a time on every width: swiped on a phone,
                  arrowed on a desktop. The cards live here, so pins, ranges
                  and entrances persist across every resize.
                -->
                <!--
                  The FlipView takes the whole row and each item centres its
                  card: a FlipView sized to its content measures the card once,
                  before the plot has taken its height, and clips the foot.
                -->
                <!--
                  ══ the index ══
                  Wide only: the four instruments by name and current reading,
                  one under the other at the left of the card. The one in the
                  room is ink; the rest are quiet. Built by the page from the
                  cards themselves, so it can never disagree with them.
                -->
                <StackPanel
                    x:Name="Index"
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,8,36,0"
                    VerticalAlignment="Center"
                    Spacing="4"
                    Visibility="Collapsed" />

                <FlipView
                    x:Name="Carousel"
                    Grid.Row="2"
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    IsTabStop="False"
                    SelectionChanged="OnCarouselChanged">
                    <FlipView.ItemContainerStyle>
                        <Style TargetType="FlipViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </FlipView.ItemContainerStyle>
                    <!-- the period labels of the ridge and the sessions are live range switchers -->
                    <controls:MeasureCard
                        x:Name="RidgeCard"
                        FootRight="hours"
                        HeadLeft="Deep work"
                        IsRangeSwitch="True"
                        RiseDelay="0"
                        Temperature="Effort">
                        <charts:RidgeChart x:Name="Ridge" />
                    </controls:MeasureCard>

                    <controls:MeasureCard
                        x:Name="SessionsCard"
                        FootRight="focus"
                        HeadLeft="Sessions"
                        IsRangeSwitch="True"
                        RiseDelay="120"
                        Temperature="Frequency">
                        <charts:StepChart x:Name="Sessions" />
                    </controls:MeasureCard>

                    <controls:MeasureCard
                        x:Name="NightCard"
                        AxisLabels="21, 00, 03, 06, 09"
                        FootRight="restful"
                        HeadLeft="Sleep"
                        HeadRight="Last night"
                        RiseDelay="240"
                        Temperature="Rest">
                        <charts:NightChart x:Name="Night" />
                    </controls:MeasureCard>

                    <controls:MeasureCard
                        x:Name="RoadCard"
                        AxisLabels="0, 25 km"
                        HeadLeft="Running"
                        HeadRight="This week"
                        RiseDelay="360"
                        Temperature="Distance">
                        <charts:RoadChart x:Name="Road" />
                    </controls:MeasureCard>

                    <!--
                      ══ the overview ══
                      The fifth stop: all four instruments at once, at reading
                      density. These are second cards over the same records -
                      the page mirrors every numeral into them - and a tap on
                      a tile turns the carousel to that instrument's own card.
                      Two by two from 620; a single scrolling column below.
                    -->
                    <ScrollViewer
                        x:Name="Overview"
                        HorizontalScrollMode="Disabled"
                        IsTabStop="False"
                        VerticalScrollBarVisibility="Auto">
                        <Grid
                            x:Name="TileGrid"
                            ColumnSpacing="16"
                            RowSpacing="16"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:MeasureCard
                                x:Name="RidgeTile"
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                FootRight="hours"
                                HeadLeft="Deep work"
                                RiseDelay="0"
                                Temperature="Effort">
                                <charts:RidgeChart x:Name="RidgeMirror" />
                            </controls:MeasureCard>

                            <controls:MeasureCard
                                x:Name="SessionsTile"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                FootRight="focus"
                                HeadLeft="Sessions"
                                RiseDelay="120"
                                Temperature="Frequency">
                                <charts:StepChart x:Name="SessionsMirror" />
                            </controls:MeasureCard>

                            <controls:MeasureCard
                                x:Name="NightTile"
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                AxisLabels="21, 00, 03, 06, 09"
                                FootRight="restful"
                                HeadLeft="Sleep"
                                HeadRight="Last night"
                                RiseDelay="240"
                                Temperature="Rest">
                                <charts:NightChart x:Name="NightMirror" />
                            </controls:MeasureCard>

                            <controls:MeasureCard
                                x:Name="RoadTile"
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                AxisLabels="0, 25 km"
                                HeadLeft="Running"
                                HeadRight="This week"
                                RiseDelay="360"
                                Temperature="Distance">
                                <charts:RoadChart x:Name="RoadMirror" />
                            </controls:MeasureCard>
                        </Grid>
                    </ScrollViewer>
                </FlipView>

            </Grid>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
