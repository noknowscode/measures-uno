<!--
  Soft Materialism. Warm tactile neutrals as the base; charcoal carries data,
  type and touch; colour exists only as temperatures of light - large,
  translucent, atmospheric. Never a saturated fill, never hue-as-accent.

  A plain root-level dictionary, not ThemeDictionaries: custom keys inside a
  ThemeDictionary resolve unreliably on Skia. Palette re-colours these very
  brush instances on ActualThemeChanged, so every consumer follows live, and it
  is the authority on the values - the literals here are only the light scheme
  written down so the designer surface has something to show. Palette verifies
  at the first Apply that every key it expects is here with the right shape.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="SerifFont">ms-appx:///Assets/Fonts/Newsreader-Light.ttf#Newsreader Light</FontFamily>
    <FontFamily x:Key="SerifItalicFont">ms-appx:///Assets/Fonts/Newsreader-LightItalic.ttf#Newsreader Light</FontFamily>
    <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/MartianMono-Regular.ttf#Martian Mono</FontFamily>

    <x:Double x:Key="LabelSize">9.5</x:Double>
    <x:Double x:Key="AxisSize">8.5</x:Double>
    <!-- in-chart text: the date line of a point label and every reference label -->
    <x:Double x:Key="ChartLabelSize">7.5</x:Double>
    <x:Double x:Key="PointValueSize">10</x:Double>
    <x:Double x:Key="CaptionSize">15</x:Double>
    <!-- 1.35 line box: italic descenders never clip against the one-line ellipsis -->
    <x:Double x:Key="CaptionLineHeight">20.25</x:Double>
    <!-- value 64, unit 26: the unit is 41% of the value, and the metric dominates the card -->
    <x:Double x:Key="NumeralSize">64</x:Double>
    <x:Double x:Key="NumeralSoftSize">26</x:Double>
    <x:Double x:Key="TitleSize">26</x:Double>

    <!--
      Two easings, and only two. Gravity eases in, hands ease out. A literal
      easing in a storyboard is a review failure. Motion authored in code reads
      these same curves through Anim.
    -->
    <KeySpline x:Key="EaseHands" ControlPoint1="0.22,1" ControlPoint2="0.36,1" />
    <KeySpline x:Key="EaseGravity" ControlPoint1="0.4,0" ControlPoint2="1,1" />

    <!-- ══ neutral axis ══ -->
    <!-- Canvas2 and CardLit exist only as gradient stops, so they have no solid brush -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F5F0EC" />
    <SolidColorBrush x:Key="CardBrush" Color="#FBF8F5" />
    <SolidColorBrush x:Key="InkBrush" Color="#1F1F1E" />
    <SolidColorBrush x:Key="QuietBrush" Color="#A19A96" />
    <SolidColorBrush x:Key="UnitBrush" Color="#BFA19A96" />

    <!-- the metric name leads the head; the period beside it stays quiet -->
    <SolidColorBrush x:Key="InkLeadBrush" Color="#9E1F1F1E" />

    <!--
      The contrast ramp. Hierarchy is carried by opacity alone: full ink for
      the series being read, 45% for axis whispers, 15% for references.
    -->
    <SolidColorBrush x:Key="HairlineBrush" Color="#1A1F1F1E" />
    <SolidColorBrush x:Key="InkSoft12Brush" Color="#1F1F1F1E" />
    <SolidColorBrush x:Key="ReferenceBrush" Color="#261F1F1E" />
    <SolidColorBrush x:Key="InkSoft35Brush" Color="#591F1F1E" />
    <SolidColorBrush x:Key="InkSoft45Brush" Color="#731F1F1E" />
    <SolidColorBrush x:Key="InkSoft50Brush" Color="#801F1F1E" />

    <LinearGradientBrush x:Key="PageBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F5F0EC" />
        <GradientStop Offset="1" Color="#E8E5E4" />
    </LinearGradientBrush>

    <!--
      The device face, lit from above and dissolving into the field at its foot.
      The last stop is the Canvas token exactly, which is what makes the foot
      dissolve instead of darken.

      Three zones, shaped against 8-bit banding rather than drawn as one ramp:
      a single-level lift across the top, a genuinely flat middle, and the whole
      dissolve concentrated in the bottom 38%. That shaping is the whole defence
      now that the card carries no grain: measured down a dark card it steps one
      level every 5-8 px, which is well under the ~20 px a visible band needs.
    -->
    <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FCFAF8" />
        <GradientStop Offset="0.30" Color="#FBF8F5" />
        <GradientStop Offset="0.62" Color="#FBF8F5" />
        <GradientStop Offset="1" Color="#F5F0EC" />
    </LinearGradientBrush>

    <!--
      ══ light axis: atmospheres, never accents ══
      Named for what they light. Hue tells the instruments apart and never
      the state: no reading may depend on it.
    -->

    <!-- effort: dawn on the ridge -->
    <LinearGradientBrush x:Key="AtmoEffortBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#D9F1E8CF" />
        <GradientStop Offset="1" Color="#2EF1E8CF" />
    </LinearGradientBrush>

    <!-- frequency: air after rain, under the step line -->
    <LinearGradientBrush x:Key="AtmoFrequencyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#D9DEE4DA" />
        <GradientStop Offset="1" Color="#2EDEE4DA" />
    </LinearGradientBrush>

    <!-- rest: lavender through the middle of the night, nothing at either edge -->
    <LinearGradientBrush x:Key="AtmoRestBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#2EE4E0E8" />
        <GradientStop Offset="0.35" Color="#73E4E0E8" />
        <GradientStop Offset="0.55" Color="#73E4E0E8" />
        <GradientStop Offset="1" Color="#2EE4E0E8" />
    </LinearGradientBrush>

    <!-- depth: the valley itself -->
    <LinearGradientBrush x:Key="AtmoDepthBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#73DCE4EA" />
        <GradientStop Offset="1" Color="#2EDCE4EA" />
    </LinearGradientBrush>

    <!--
      distance: late sun left on the road, at 0.6 - the brief's own watch item,
      taken: at full strength it tipped into reading as "pink" rather than as
      light. Dark dims it on the same ratio as every other wash.
    -->
    <SolidColorBrush x:Key="AtmoDistanceBrush" Color="#99F1DEDA" />

</ResourceDictionary>
