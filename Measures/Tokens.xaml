<!--
  The law of the page: history is drawn in ink, the living edge in indigo.
  A plain root-level dictionary, not ThemeDictionaries: custom keys inside a
  ThemeDictionary resolve unreliably on Skia. Palette re-colours these very
  brush instances on ActualThemeChanged, so every consumer follows live.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="SerifFont">ms-appx:///Assets/Fonts/Newsreader-Light.ttf#Newsreader Light</FontFamily>
    <FontFamily x:Key="SerifItalicFont">ms-appx:///Assets/Fonts/Newsreader-LightItalic.ttf#Newsreader Light</FontFamily>
    <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/MartianMono-Regular.ttf#Martian Mono</FontFamily>

    <x:Double x:Key="LabelSize">9.5</x:Double>
    <x:Double x:Key="AxisSize">8.5</x:Double>
    <x:Double x:Key="CaptionSize">15</x:Double>
    <x:Double x:Key="NumeralSize">60</x:Double>
    <x:Double x:Key="NumeralSoftSize">24</x:Double>
    <x:Double x:Key="TitleSize">26</x:Double>

    <!-- solids; Alpha is authored here and preserved by Palette on theme change -->
    <SolidColorBrush x:Key="MistBrush"      Color="#F6F7F5" />
    <SolidColorBrush x:Key="Mist2Brush"     Color="#F1F3F1" />
    <SolidColorBrush x:Key="CardBrush"      Color="#FBFCFB" />
    <SolidColorBrush x:Key="InkBrush"       Color="#2C2E2C" />
    <SolidColorBrush x:Key="QuietBrush"     Color="#9AA09B" />
    <SolidColorBrush x:Key="AiBrush"        Color="#5A6C8F" />
    <SolidColorBrush x:Key="HairlineBrush"  Color="#1A2C2E2C" />
    <SolidColorBrush x:Key="InkSoft12Brush" Color="#1F2C2E2C" />
    <SolidColorBrush x:Key="InkSoft22Brush" Color="#382C2E2C" />
    <SolidColorBrush x:Key="InkSoft35Brush" Color="#592C2E2C" />
    <SolidColorBrush x:Key="AiSoft50Brush"  Color="#805A6C8F" />
    <SolidColorBrush x:Key="AiSoft40Brush"  Color="#665A6C8F" />
    <SolidColorBrush x:Key="AiSoft35Brush"  Color="#595A6C8F" />

    <LinearGradientBrush x:Key="PageBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F6F7F5" />
        <GradientStop Offset="1" Color="#F1F3F1" />
    </LinearGradientBrush>

    <!-- the mist under the ridge -->
    <LinearGradientBrush x:Key="RidgeMistBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#295A6C8F" />
        <GradientStop Offset="1" Color="#005A6C8F" />
    </LinearGradientBrush>

    <!-- night sky: light in the middle of the night, nothing at either edge -->
    <LinearGradientBrush x:Key="NightSkyBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0"    Color="#005A6C8F" />
        <GradientStop Offset="0.35" Color="#1A5A6C8F" />
        <GradientStop Offset="0.55" Color="#1A5A6C8F" />
        <GradientStop Offset="1"    Color="#005A6C8F" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RestFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#335A6C8F" />
        <GradientStop Offset="1" Color="#055A6C8F" />
    </LinearGradientBrush>

    <!-- the pour that fills a stem from the top down -->
    <LinearGradientBrush x:Key="StemPourBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF5A6C8F" />
        <GradientStop Offset="1" Color="#595A6C8F" />
    </LinearGradientBrush>

</ResourceDictionary>
