<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Measures.Controls"
    xmlns:charts="using:Measures.Charts">



    <!-- ══ SpacedText ══ -->

    <Style x:Key="SpacedTextBase" TargetType="controls:SpacedText">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SpacedText">
                    <StackPanel x:Name="PART_Host" Orientation="Horizontal" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SpacedText" BasedOn="{StaticResource SpacedTextBase}" />

    <!-- ══ type roles ══ -->

    <Style x:Key="LabelStyle" TargetType="controls:SpacedText" BasedOn="{StaticResource SpacedTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="Foreground" Value="{StaticResource QuietBrush}" />
        <Setter Property="Tracking" Value="0.18" />
        <Setter Property="IsUpperCase" Value="True" />
    </Style>

    <Style x:Key="AxisStyle" TargetType="controls:SpacedText" BasedOn="{StaticResource SpacedTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource AxisSize}" />
        <Setter Property="Foreground" Value="{StaticResource QuietBrush}" />
        <Setter Property="Tracking" Value="0.12" />
    </Style>

    <!-- ══ SpacedText ══ -->



    <!-- ══ CaptionPresenter ══ -->

    <Style TargetType="controls:CaptionPresenter">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CaptionPresenter">
                    <!-- the reading never wraps and never resizes the card -->
                    <TextBlock
                        x:Name="PART_Text"
                        FontFamily="{StaticResource SerifItalicFont}"
                        FontSize="{StaticResource CaptionSize}"
                        FontStyle="Italic"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ DotButton ══ -->

    <Style TargetType="controls:DotButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DotButton">
                    <Grid
                        Width="{TemplateBinding HitSize}"
                        Height="{TemplateBinding HitSize}"
                        Background="Transparent">
                        <!-- 2 epx indigo ring, 3 epx clear of the mark -->
                        <Ellipse
                            x:Name="PART_Focus"
                            Width="{TemplateBinding FocusSize}"
                            Height="{TemplateBinding FocusSize}"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Stroke="{StaticResource AiBrush}"
                            StrokeThickness="2" />
                        <Ellipse
                            x:Name="PART_Mark"
                            Width="{TemplateBinding BaseSize}"
                            Height="{TemplateBinding BaseSize}"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ BeadColumn ══ -->

    <Style TargetType="controls:BeadColumn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:BeadColumn">
                    <Grid Background="Transparent">
                        <Rectangle
                            x:Name="PART_Focus"
                            Margin="-3"
                            IsHitTestVisible="False"
                            Opacity="0"
                            RadiusX="8"
                            RadiusY="8"
                            Stroke="{StaticResource AiBrush}"
                            StrokeThickness="2" />
                        <!-- the beads are built in code; the ring spreads from where the top one lands -->
                        <Canvas x:Name="PART_Beads" IsHitTestVisible="False" />
                        <Canvas IsHitTestVisible="False">
                            <Ellipse
                                x:Name="PART_Plip"
                                Width="4.5"
                                Height="4.5"
                                Opacity="0"
                                Stroke="{StaticResource AiBrush}"
                                StrokeThickness="1" />
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ quiet button ══ -->

    <!--
      Opaque, so it never reads as a floating glyph on the mist, and hairline,
      so it stays furniture: the instruments are the only bold thing here.
    -->
    <Style x:Key="QuietButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border
                            x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="999"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Press" />
                            </Border.RenderTransform>
                            <ContentPresenter
                                x:Name="Label"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border
                            x:Name="FocusRing"
                            Margin="-3"
                            BorderBrush="{StaticResource AiBrush}"
                            BorderThickness="2"
                            CornerRadius="999"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.BorderBrush" Value="{StaticResource AiSoft40Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.BorderBrush" Value="{StaticResource AiSoft40Brush}" />
                                        <!-- 0.98 is the house press for XAML; 0.96 is the web value -->
                                        <Setter Target="Press.ScaleX" Value="0.98" />
                                        <Setter Target="Press.ScaleY" Value="0.98" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ charts ══ -->

    <Style x:Key="ChartHostStyle" TargetType="Control">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style TargetType="charts:RidgeChart" BasedOn="{StaticResource ChartHostStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="charts:RidgeChart">
                    <Canvas x:Name="PART_Plot" Height="{TemplateBinding PlotHeight}">
                        <Path x:Name="PART_Fill" Fill="{StaticResource RidgeMistBrush}" />
                        <Path
                            x:Name="PART_Line"
                            Stroke="{StaticResource InkBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                        <Line
                            x:Name="PART_Pin"
                            Opacity="0"
                            Stroke="{StaticResource AiSoft50Brush}"
                            StrokeThickness="1" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="charts:RainChart" BasedOn="{StaticResource ChartHostStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="charts:RainChart">
                    <Canvas x:Name="PART_Plot" Height="{TemplateBinding PlotHeight}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="charts:NightChart" BasedOn="{StaticResource ChartHostStyle}">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="charts:NightChart">
                    <!-- Background makes the whole plot pressable, not just the ink -->
                    <Canvas
                        x:Name="PART_Plot"
                        Height="{TemplateBinding PlotHeight}"
                        Background="Transparent">
                        <Rectangle
                            x:Name="PART_Sky"
                            Fill="{StaticResource NightSkyBrush}"
                            RadiusX="6"
                            RadiusY="6" />
                        <Line
                            x:Name="PART_Horizon"
                            Stroke="{StaticResource InkSoft12Brush}"
                            StrokeThickness="1" />
                        <Path x:Name="PART_Rest" Fill="{StaticResource RestFillBrush}" />
                        <Path
                            x:Name="PART_Curve"
                            Stroke="{StaticResource AiBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                        <Ellipse
                            x:Name="PART_Wake"
                            Width="7"
                            Height="7"
                            Fill="{StaticResource AiBrush}" />
                        <Line
                            x:Name="PART_ScrubLine"
                            Opacity="0"
                            Stroke="{StaticResource AiSoft40Brush}"
                            StrokeThickness="1" />
                        <Ellipse
                            x:Name="PART_ScrubDot"
                            Width="6"
                            Height="6"
                            Opacity="0"
                            Fill="{StaticResource AiBrush}" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="charts:RoadChart" BasedOn="{StaticResource ChartHostStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="charts:RoadChart">
                    <Canvas x:Name="PART_Plot" Height="{TemplateBinding PlotHeight}">
                        <!-- the road ahead, still dashed -->
                        <Path
                            x:Name="PART_Ghost"
                            Stroke="{StaticResource InkSoft22Brush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1" />
                        <!-- the wake the runner leaves -->
                        <Path
                            x:Name="PART_Trace"
                            Opacity="0"
                            Stroke="{StaticResource AiBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2.5" />
                        <Path
                            x:Name="PART_Progress"
                            Stroke="{StaticResource AiBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <Ellipse
                            x:Name="PART_Start"
                            Width="4"
                            Height="4"
                            Fill="{StaticResource InkBrush}" />
                        <Ellipse
                            x:Name="PART_Echo"
                            Width="8"
                            Height="8"
                            Opacity="0"
                            Stroke="{StaticResource AiBrush}"
                            StrokeThickness="1.5" />
                        <Ellipse
                            x:Name="PART_Runner"
                            Width="6"
                            Height="6"
                            Opacity="0"
                            Fill="{StaticResource AiBrush}"
                            Stroke="{StaticResource CardBrush}"
                            StrokeThickness="1" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ MeasureCard ══ -->

    <Style TargetType="controls:MeasureCard">
        <Setter Property="MinHeight" Value="300" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Bottom" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MeasureCard">
                    <Grid x:Name="PART_Rise">
                        <Border
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- head -->
                                <Grid Padding="28,28,28,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:SpacedText
                                        Style="{StaticResource LabelStyle}"
                                        Text="{TemplateBinding HeadLeft}" />
                                    <controls:SpacedText
                                        Grid.Column="1"
                                        Style="{StaticResource LabelStyle}"
                                        Text="{TemplateBinding HeadRight}" />
                                </Grid>

                                <!-- body: numeral pinned top, chart pinned bottom -->
                                <Grid Grid.Row="1" Padding="28,0,28,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        x:Name="PART_Numeral"
                                        FontFamily="{StaticResource SerifFont}"
                                        FontSize="{StaticResource NumeralSize}"
                                        Foreground="{StaticResource InkBrush}"
                                        LineHeight="{StaticResource NumeralSize}"
                                        LineStackingStrategy="BlockLineHeight"
                                        TextWrapping="NoWrap" />

                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="0,22,0,0"
                                        VerticalAlignment="Bottom">
                                        <ContentPresenter
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            HorizontalAlignment="Stretch" />
                                        <Canvas x:Name="PART_Axis" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- foot -->
                                <Grid Grid.Row="2" Padding="28" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:CaptionPresenter x:Name="PART_Caption" />
                                    <controls:SpacedText
                                        Grid.Column="1"
                                        Style="{StaticResource LabelStyle}"
                                        Text="{TemplateBinding FootRight}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
