<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Measures.Controls"
    xmlns:charts="using:Measures.Charts">

    <!-- ══ SpacedText ══ -->

    <Style x:Key="SpacedTextBase" TargetType="controls:SpacedText">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SpacedText">
                    <StackPanel x:Name="PART_Host" Orientation="Horizontal" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SpacedText" BasedOn="{StaticResource SpacedTextBase}" />

    <!-- ══ type roles ══ -->

    <Style x:Key="LabelStyle" TargetType="controls:SpacedText" BasedOn="{StaticResource SpacedTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
        <Setter Property="Foreground" Value="{StaticResource QuietBrush}" />
        <Setter Property="Tracking" Value="0.18" />
        <Setter Property="IsUpperCase" Value="True" />
    </Style>

    <!--
      The head is two labels at two weights: the metric name is what the card
      is, so it leads at 62% ink; the period beside it is a footnote and stays
      quiet. Same size, same tracking - the hierarchy is carried by value only.
    -->
    <Style x:Key="LabelLeadStyle" TargetType="controls:SpacedText" BasedOn="{StaticResource LabelStyle}">
        <Setter Property="Foreground" Value="{StaticResource InkLeadBrush}" />
    </Style>

    <!-- axis whispers at 45% ink: they are read, so they are no longer decorative taupe -->
    <Style x:Key="AxisStyle" TargetType="controls:SpacedText" BasedOn="{StaticResource SpacedTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource AxisSize}" />
        <Setter Property="Foreground" Value="{StaticResource InkSoft45Brush}" />
        <Setter Property="Tracking" Value="0.12" />
    </Style>

    <!-- ══ GrainLayer ══ -->

    <Style TargetType="controls:GrainLayer">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GrainLayer">
                    <Canvas x:Name="PART_Tiles" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ CaptionPresenter ══ -->

    <Style TargetType="controls:CaptionPresenter">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CaptionPresenter">
                    <!-- the reading never wraps and never resizes the card -->
                    <TextBlock
                        x:Name="PART_Text"
                        FontFamily="{StaticResource SerifItalicFont}"
                        FontSize="{StaticResource CaptionSize}"
                        FontStyle="Italic"
                        LineHeight="{StaticResource CaptionLineHeight}"
                        LineStackingStrategy="BlockLineHeight"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ DotButton ══ -->

    <Style TargetType="controls:DotButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DotButton">
                    <Grid
                        Width="{TemplateBinding HitSize}"
                        Height="{TemplateBinding HitSize}"
                        Background="Transparent">
                        <!-- 2 epx charcoal ring, 3 epx clear of the mark -->
                        <Ellipse
                            x:Name="PART_Focus"
                            Width="{TemplateBinding FocusSize}"
                            Height="{TemplateBinding FocusSize}"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Stroke="{StaticResource InkBrush}"
                            StrokeThickness="2" />
                        <Ellipse
                            x:Name="PART_Mark"
                            Width="{TemplateBinding BaseSize}"
                            Height="{TemplateBinding BaseSize}"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ DaySlot ══ -->

    <Style TargetType="controls:DaySlot">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DaySlot">
                    <Grid Background="Transparent">
                        <Rectangle
                            x:Name="PART_Focus"
                            Margin="1"
                            IsHitTestVisible="False"
                            Opacity="0"
                            RadiusX="6"
                            RadiusY="6"
                            Stroke="{StaticResource InkBrush}"
                            StrokeThickness="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ RangeSwitch ══ -->

    <!--
      The period label as a switch: the label style exactly, plus a caret, and
      a faint ink tint only under the pointer. No chrome - the caret is the
      whole affordance, and it is only drawn where a tap does something.
    -->
    <Style TargetType="controls:RangeSwitch">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:RangeSwitch">
                    <Grid Background="Transparent">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="5"
                            VerticalAlignment="Bottom">
                            <controls:SpacedText
                                x:Name="PART_Label"
                                Style="{StaticResource LabelStyle}"
                                Text="{TemplateBinding Text}" />
                            <Path
                                x:Name="PART_Caret"
                                Width="7"
                                Height="4"
                                Margin="0,0,0,2"
                                VerticalAlignment="Bottom"
                                Data="M0.5,0.5 L3.5,3.5 L6.5,0.5"
                                Stroke="{StaticResource QuietBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1" />
                        </StackPanel>
                        <Border
                            x:Name="FocusRing"
                            Margin="-5,-3"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Label.Foreground" Value="{StaticResource InkSoft50Brush}" />
                                        <Setter Target="PART_Caret.Stroke" Value="{StaticResource InkSoft50Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Label.Foreground" Value="{StaticResource InkBrush}" />
                                        <Setter Target="PART_Caret.Stroke" Value="{StaticResource InkBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ quiet button ══ -->

    <!--
      Opaque, so it never reads as a floating glyph on the mist, and hairline,
      so it stays furniture: the instruments are the only bold thing here.
      The radius is half the 28 epx height, written out: an oversized radius
      is reduced per axis on the Skia renderer and the pill becomes an oval.
    -->
    <Style x:Key="QuietButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border
                            x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Press" />
                            </Border.RenderTransform>
                            <ContentPresenter
                                x:Name="Label"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border
                            x:Name="FocusRing"
                            Margin="-3"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="2"
                            CornerRadius="17"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.BorderBrush" Value="{StaticResource InkSoft35Brush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.BorderBrush" Value="{StaticResource InkSoft35Brush}" />
                                        <!-- 0.98 is the house press for XAML; 0.96 is the web value -->
                                        <Setter Target="Press.ScaleX" Value="0.98" />
                                        <Setter Target="Press.ScaleY" Value="0.98" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ charts ══ -->

    <!--
      Every plot is a 300:120 box whose height follows its width; the chart
      sets PlotHeight from the width it is given. Data spans x 10 to 290 of
      the box in all four, and the annotation layer sits last in each canvas.
    -->
    <Style x:Key="ChartHostStyle" TargetType="Control">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style TargetType="charts:RidgeChart" BasedOn="{StaticResource ChartHostStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="charts:RidgeChart">
                    <Canvas x:Name="PART_Plot" Height="{TemplateBinding PlotHeight}">
                        <Path x:Name="PART_Fill" Fill="{StaticResource AtmoEffortBrush}" />
                        <!-- the reference: a dashed rule at the true average -->
                        <Path
                            x:Name="PART_Avg"
                            Stroke="{StaticResource ReferenceBrush}"
                            StrokeThickness="1" />
                        <Path
                            x:Name="PART_Line"
                            Stroke="{StaticResource InkBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                        <!-- the plumb is contrast and position, never a hue -->
                        <Line
                            x:Name="PART_Pin"
                            Opacity="0"
                            Stroke="{StaticResource InkSoft50Brush}"
                            StrokeThickness="1" />
                        <controls:PointLabel x:Name="PART_Label" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="charts:StepChart" BasedOn="{StaticResource ChartHostStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="charts:StepChart">
                    <Canvas x:Name="PART_Plot" Height="{TemplateBinding PlotHeight}">
                        <Path x:Name="PART_Fill" Fill="{StaticResource AtmoFrequencyBrush}" />
                        <Path
                            x:Name="PART_Avg"
                            Stroke="{StaticResource ReferenceBrush}"
                            StrokeThickness="1" />
                        <!-- round joins soften the corners of the steps without smoothing them -->
                        <Path
                            x:Name="PART_Line"
                            Stroke="{StaticResource InkBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                        <Line
                            x:Name="PART_Pin"
                            Opacity="0"
                            Stroke="{StaticResource InkSoft50Brush}"
                            StrokeThickness="1" />
                        <!-- the doctrine: hollow at the peak, solid for today and for the chosen day -->
                        <Ellipse
                            x:Name="PART_Peak"
                            Width="5"
                            Height="5"
                            Fill="{StaticResource CardBrush}"
                            Stroke="{StaticResource InkBrush}"
                            StrokeThickness="1.5" />
                        <Ellipse
                            x:Name="PART_Hover"
                            Width="7.5"
                            Height="7.5"
                            Fill="{StaticResource CardBrush}"
                            Opacity="0"
                            Stroke="{StaticResource InkBrush}"
                            StrokeThickness="1.5" />
                        <Ellipse
                            x:Name="PART_Chosen"
                            Width="8"
                            Height="8"
                            Fill="{StaticResource InkBrush}"
                            Opacity="0" />
                        <Ellipse
                            x:Name="PART_Today"
                            Width="7"
                            Height="7"
                            Fill="{StaticResource InkBrush}" />
                        <controls:PointLabel x:Name="PART_Label" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="charts:NightChart" BasedOn="{StaticResource ChartHostStyle}">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="charts:NightChart">
                    <!-- Background makes the whole plot pressable, not just the ink -->
                    <Canvas
                        x:Name="PART_Plot"
                        Height="{TemplateBinding PlotHeight}"
                        Background="Transparent">
                        <Rectangle
                            x:Name="PART_Sky"
                            Fill="{StaticResource AtmoRestBrush}"
                            RadiusX="6"
                            RadiusY="6" />
                        <Line
                            x:Name="PART_Horizon"
                            Stroke="{StaticResource InkSoft12Brush}"
                            StrokeThickness="1" />
                        <!-- mist-blue for the depth of the valley -->
                        <Path x:Name="PART_Rest" Fill="{StaticResource AtmoDepthBrush}" />
                        <!-- the night curve is data, so it is charcoal like all data -->
                        <Path
                            x:Name="PART_Curve"
                            Stroke="{StaticResource InkBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                        <Ellipse
                            x:Name="PART_Wake"
                            Width="7"
                            Height="7"
                            Fill="{StaticResource InkBrush}" />
                        <Line
                            x:Name="PART_ScrubLine"
                            Opacity="0"
                            Stroke="{StaticResource InkSoft35Brush}"
                            StrokeThickness="1" />
                        <Ellipse
                            x:Name="PART_ScrubDot"
                            Width="6"
                            Height="6"
                            Opacity="0"
                            Fill="{StaticResource InkBrush}" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="charts:RoadChart" BasedOn="{StaticResource ChartHostStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="charts:RoadChart">
                    <Canvas x:Name="PART_Plot" Height="{TemplateBinding PlotHeight}">
                        <!-- the road ahead: dashed, and a reference, so it sits at 15% -->
                        <Path
                            x:Name="PART_Ghost"
                            Stroke="{StaticResource ReferenceBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1" />
                        <!--
                          The wake: late sun left on the road. Wide and soft and
                          under the charcoal progress, so it reads as light the
                          runner left behind rather than as a second line.
                        -->
                        <Path
                            x:Name="PART_Trace"
                            Opacity="0"
                            Stroke="{StaticResource AtmoDistanceBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="6" />
                        <Path
                            x:Name="PART_Progress"
                            Stroke="{StaticResource InkBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <Ellipse
                            x:Name="PART_Start"
                            Width="4"
                            Height="4"
                            Fill="{StaticResource InkBrush}" />
                        <!-- the finish line says hello once, in blush -->
                        <Ellipse
                            x:Name="PART_Echo"
                            Width="8"
                            Height="8"
                            Opacity="0"
                            Stroke="{StaticResource AtmoDistanceBrush}"
                            StrokeThickness="1.5" />
                        <Ellipse
                            x:Name="PART_Runner"
                            Width="6"
                            Height="6"
                            Opacity="0"
                            Fill="{StaticResource InkBrush}"
                            Stroke="{StaticResource CardBrush}"
                            StrokeThickness="1" />
                        <controls:PointLabel x:Name="PART_Label" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ PipButton ══ -->
    <!-- a 24 epx hit around a 5 epx pip; nothing drawn but the pip itself -->
    <Style x:Key="PipButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse
                            x:Name="FocusRing"
                            Width="14"
                            Height="14"
                            Stroke="{StaticResource InkBrush}"
                            StrokeThickness="1.5"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ IndexButton ══ -->
    <!--
      A row of the wide layout's index: bare, so the whole rail reads as a
      column of type and hairlines rather than a stack of buttons. Content is
      supplied by the page; the press lives on a scale, as every tactile thing
      here does.
    -->
    <Style x:Key="IndexButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,14,0,14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Press" />
                            </Border.RenderTransform>
                            <ContentPresenter x:Name="Label" HorizontalAlignment="Stretch" />
                        </Border>
                        <Rectangle
                            Grid.Row="1"
                            Height="1"
                            Fill="{StaticResource HairlineBrush}" />
                        <Border
                            x:Name="FocusRing"
                            Margin="-6,-2"
                            BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Press"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.98"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="Press"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.98"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ MeasureCard ══ -->

    <Style TargetType="controls:MeasureCard">
        <Setter Property="MinHeight" Value="300" />
        <!--
          One card fills the row, so the cap is what keeps a desktop card a card
          and not a poster: 720 is where the numeral reaches 96 and the plot 260.
          The card scales its own chrome between 300 and 720 (see Density).
        -->
        <Setter Property="MaxWidth" Value="720" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MeasureCard">
                    <Grid x:Name="PART_Rise">
                        <Border
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="24">
                            <!-- the anatomy: LABEL·PERIOD / VALUE+UNIT / CHART / rule / CONTEXT·DETAIL -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--
                                  The room's light, descending from the top edge.
                                  Filled from code: every card is a different
                                  temperature, so the brush cannot be shared.
                                  RowSpan, because a layer that sat in row 0
                                  would be as tall as the head and no taller.
                                -->
                                <Rectangle
                                    x:Name="PART_EdgeLight"
                                    Grid.RowSpan="5"
                                    IsHitTestVisible="False"
                                    RadiusX="23"
                                    RadiusY="23" />

                                <!-- head -->
                                <Grid x:Name="PART_Head" Grid.Row="0" Padding="28,28,28,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:SpacedText
                                        Style="{StaticResource LabelLeadStyle}"
                                        Text="{TemplateBinding HeadLeft}" />
                                    <!-- a plain period, or a switcher; the card shows one -->
                                    <controls:SpacedText
                                        x:Name="PART_HeadLabel"
                                        Grid.Column="1"
                                        Style="{StaticResource LabelStyle}"
                                        Text="{TemplateBinding HeadRight}" />
                                    <controls:RangeSwitch
                                        x:Name="PART_Range"
                                        Grid.Column="1"
                                        Text="{TemplateBinding HeadRight}"
                                        Visibility="Collapsed" />
                                </Grid>

                                <!--
                                  body: the metric column is top-anchored with a
                                  fixed 40 epx to the chart, so slack never pools
                                  between them - it falls through to the foot
                                -->
                                <StackPanel x:Name="PART_Body" Grid.Row="1" Padding="28,0,28,0">
                                    <TextBlock
                                        x:Name="PART_Numeral"
                                        FontFamily="{StaticResource SerifFont}"
                                        FontSize="{StaticResource NumeralSize}"
                                        Foreground="{StaticResource InkBrush}"
                                        LineHeight="{StaticResource NumeralSize}"
                                        LineStackingStrategy="BlockLineHeight"
                                        TextWrapping="NoWrap" />
                                    <ContentPresenter
                                        x:Name="PART_Chart"
                                        Margin="0,40,0,0"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalAlignment="Stretch" />
                                    <Canvas x:Name="PART_Axis" Margin="0,8,0,0" />
                                </StackPanel>

                                <!-- the footer baseline: one hairline above every foot -->
                                <Rectangle
                                    x:Name="PART_Rule"
                                    Grid.Row="3"
                                    Height="1"
                                    Margin="28,18,28,0"
                                    Fill="{StaticResource HairlineBrush}" />

                                <!-- foot -->
                                <Grid x:Name="PART_Foot" Grid.Row="4" Padding="28,18,28,28" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:CaptionPresenter x:Name="PART_Caption" />
                                    <controls:SpacedText
                                        Grid.Column="1"
                                        Style="{StaticResource LabelStyle}"
                                        Text="{TemplateBinding FootRight}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
