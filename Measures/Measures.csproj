<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-desktop;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Measures</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.measures.app</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Measures</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Measures powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <!-- dotnet build -p:FrameWatch=true keeps the per-second frame log in a Release build, for measuring on a device -->
  <PropertyGroup Condition="'$(FrameWatch)' == 'true'">
    <DefineConstants>$(DefineConstants);FRAMEWATCH</DefineConstants>
  </PropertyGroup>

</Project>
